# Configuración de Base de Datos (PostgreSQL local)
DATABASE_URL=postgresql://norbridge:norbridge@localhost:5432/norbridge

# Credenciales usadas por docker-compose (db service)
POSTGRES_USER=norbridge
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=norbridge

# Configuración del Servidor
PORT=4001
NODE_ENV=production

# JWT Secret para tokens
JWT_SECRET=your-secret-here

# Clave maestra para admin
ADMIN_PASSWORD=your-admin-password

# Código maestro de acceso al dashboard (backup si no llega el OTP, opcional)
MASTER_CODE=

# API Key de Groq
GROQ_API_KEY=your-groq-api-key

# URL del frontend para CORS
FRONTEND_URL=https://school-flow-inky.vercel.app
